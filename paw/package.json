{
  "name": "paw-desktop-pet",
  "version": "0.7.1",
  "description": "Paw — a little friend for your desktop",
  "author": "Руслан Доля",
  "main": "src/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/dolaruslan872-alt/354345.git",
    "directory": "paw"
  },
  "type": "module",
  "build": {
    "appId": "app.paw.desktop",
    "productName": "Paw",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Paw-${version}-windows-${arch}-Setup.exe"
    },
    "mac": {
      "icon": "src/assets/icon.icns",
      "category": "public.app-category.entertainment",
      "target": [
        "zip"
      ],
      "artifactName": "Paw-${version}-mac-${arch}.zip",
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0"
    },
    "publish": []
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac zip --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  }
}
