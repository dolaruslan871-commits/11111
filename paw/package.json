{
  "name": "paw-desktop-pet",
  "version": "0.5.0",
  "private": true,
  "description": "Paw \u2014 a little friend for your desktop",
  "author": "Paw",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node scripts/ui-smoke.cjs",
    "test:desktop": "node scripts/electron-v5.cjs",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1 --directory src",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --dir",
    "vendor": "node scripts/vendor.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "mp4-muxer": "5.2.2",
    "playwright-core": "1.64.1",
    "three": "0.186.1"
  },
  "build": {
    "appId": "app.paw.desktop",
    "productName": "Paw",
    "icon": "src/assets/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "artifactName": "Paw-${version}-windows-${arch}-Setup.${ext}"
    },
    "artifactName": "Paw-${version}-${os}-${arch}.${ext}",
    "publish": []
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dolaruslan871-commits/11111.git",
    "directory": "paw"
  }
}
